{
  "name": "antcode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/src/server.ts --dev",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "node -e \"require('node:fs').rmSync('server/dist', { recursive: true, force: true })\" && tsc -p server/tsconfig.json",
    "start": "node server/dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json --noEmit && tsc --noEmit",
    "test": "NODE_ENV=test BETTER_AUTH_SKIP_SCHEMA_CHECK=1 BETTER_AUTH_SECRET=test-only-better-auth-secret-000000000000 BETTER_AUTH_URL=https://localhost:3000 node --experimental-test-module-mocks --import tsx --test \"client/tests/**/*.test.ts\" \"server/tests/**/*.test.ts\"",
    "test:auth": "NODE_ENV=production node --import tsx --test server/integration/auth.test.ts",
    "auth:migrate": "auth migrate --config server/src/auth/auth.ts --yes",
    "auth:check": "auth check schema --config server/src/auth/auth.ts",
    "seed": "node --import tsx server/src/db/seed/problems.ts",
    "contract:emit": "prisma contract emit",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "1.7.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "kysely": "0.29.6",
    "monaco-editor": "^0.57.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intersection-observer": "^11.0.1",
    "react-resizable-panels": "^4.13.1",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@prisma/cli-engine": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/express": "^5.0.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "1.7.6",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "jsdom": "26.1.0",
    "oxlint": "^1.83.0",
    "prisma": "^8.0.0-rc.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
