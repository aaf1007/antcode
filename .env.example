# Copy this file to `.env`. These defaults match the Postgres service in
# `docker-compose.yml` — start it with `docker compose up -d`.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://antcode:antcode@localhost:5433/antcode_db"

# Generate with `openssl rand -base64 48` and paste the result here.
BETTER_AUTH_SECRET=""
# The origin seen by the browser, not Express's internal address. Use HTTPS in production.
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated proxy IPs/CIDRs for a deployment behind trusted proxies.
# BETTER_AUTH_TRUSTED_PROXIES="192.0.2.10"
# BETTER_AUTH_TRUSTED_ORIGINS is rejected at startup; BETTER_AUTH_URL is the only trusted origin.

# Express API port in development (Vite runs on port 3000).
API_PORT=5001

# Express serves only the API in production; host the frontend separately.
PORT=3000
# Listener address. Defaults to 127.0.0.1 in development and 0.0.0.0 in production.
# HOST=0.0.0.0
